# Global machine toolchain. Copy to ~/.config/mise/config.toml, then `mise install`.
#
# Versions below are pinned exact (the set this machine runs). Bump deliberately.
# No floating `latest` in the committed config: it re-resolves on its own schedule
# and drifts the ruleset until a gate fails on code nobody touched.

[tools]
# --- always ---
jj           = "0.42.0"   # jujutsu, colocated with git
just         = "1.52.0"
shellcheck   = "0.11.0"
# ripgrep / fd / osv-scanner: install and pin to the version mise writes:
#   mise use -g aqua:BurntSushi/ripgrep aqua:sharkdp/fd aqua:google/osv-scanner
# "aqua:BurntSushi/ripgrep" = "<pin>"   # the agent's search primitives
# "aqua:sharkdp/fd"         = "<pin>"
# "aqua:google/osv-scanner" = "<pin>"   # `just audit`

# --- machine-wide oracles ---
"aqua:ast-grep/ast-grep" = "0.44.0"   # structural search + custom lint rules
"aqua:gitleaks/gitleaks" = "8.30.1"   # secret-leak gate
"aqua:rhysd/actionlint"  = "1.7.12"   # GitHub Actions workflow lint
"aqua:crate-ci/typos"    = "1.47.2"   # source spell-check (optional)

# Per-language toolchains (rust, node, pnpm, uv, ruff, pyright, cargo-nextest)
# are pinned per PROJECT in its own .mise.toml, not here.
